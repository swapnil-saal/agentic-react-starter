# Copy to .env and fill in. Parsed and validated by src/lib/env.ts at boot —
# a missing or malformed value fails fast with a readable message.

# Base URL for your API. Required, must be a valid URL.
VITE_API_URL="http://localhost:3000"

# Run the in-browser mock API (src/mocks). Set to "false" once you have a
# real backend at VITE_API_URL.
VITE_ENABLE_MOCKS="true"
