      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:run)",
      "Bash(pnpm e2e)",
      "Bash(pnpm format)",
      "Bash(pnpm doctor)",
      "Bash(pnpm doctor:check)",
