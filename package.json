{
  "name": "agentic-react-starter",
  "description": "Vite + React + TypeScript starter wired for Claude-powered agentic development",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "Swapnil Shukla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swapnil-saal/agentic-react-starter.git"
  },
  "bugs": {
    "url": "https://github.com/swapnil-saal/agentic-react-starter/issues"
  },
  "homepage": "https://github.com/swapnil-saal/agentic-react-starter#readme",
  "keywords": [
    "react",
    "vite",
    "typescript",
    "design-system",
    "base-ui",
    "tailwindcss",
    "design-tokens",
    "starter",
    "template",
    "claude",
    "agentic",
    "ai-agents"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm check:tokens && pnpm test:run",
    "reset": "node scripts/reset.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:check": "node scripts/doctor.mjs --check",
    "prepare": "husky",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.87.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.104.2",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.45",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "msw": "^3.0.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
